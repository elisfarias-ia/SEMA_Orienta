{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cadastro de um serviço do SEMA Orienta",
  "description": "Documentação da estrutura de services/<id>/service.json e dos arquivos complementares (fontes, documentos, perguntas frequentes). A conferência é feita por scripts/validate-services.js. Enquanto o serviço estiver em rascunho, o conteúdo material deve permanecer PENDENTE, null ou lista vazia.",
  "type": "object",
  "required": [
    "id", "nome", "sigla", "categoria", "termosEquivalentes", "arquivos",
    "statusValidacao", "publicado", "descricao", "publico", "condicoes", "etapas",
    "unidadeResponsavel", "responsavelValidacao", "dataRevisao", "canalAtendimento",
    "sistemaInicio", "links", "legislacao", "pendencias"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "nome": { "type": "string", "minLength": 1 },
    "sigla": { "type": "string", "minLength": 1 },
    "categoria": { "type": "string", "minLength": 1 },
    "termosEquivalentes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "arquivos": {
      "type": "object",
      "required": ["roteiro", "documentos", "perguntasFrequentes", "fontes"],
      "additionalProperties": false,
      "properties": {
        "roteiro": { "type": "string" },
        "documentos": { "type": "string" },
        "perguntasFrequentes": { "type": "string" },
        "fontes": { "type": "string" }
      }
    },
    "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
    "publicado": { "type": "boolean" },
    "descricao": { "type": "string" },
    "publico": { "type": "string" },
    "condicoes": { "type": "array", "items": { "type": "string" } },
    "etapas": { "type": "array", "items": { "type": "string" } },
    "unidadeResponsavel": { "type": "string" },
    "responsavelValidacao": { "type": ["string", "null"] },
    "dataRevisao": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "canalAtendimento": { "$ref": "#/$defs/pontoDeAcesso" },
    "sistemaInicio": { "$ref": "#/$defs/pontoDeAcesso" },
    "links": {
      "type": "array",
      "description": "Identificadores de fontes cadastradas em fontes.json.",
      "items": { "type": "string" }
    },
    "legislacao": {
      "type": "array",
      "description": "Identificadores de fontes do tipo legislacao cadastradas em fontes.json.",
      "items": { "type": "string" }
    },
    "referencias": {
      "type": "object",
      "description": "Fontes que sustentam cada campo de conteúdo (descricao, publico, condicoes, etapas, sistemaInicio, canalAtendimento). Obrigatória para todo campo preenchido quando o serviço não está em rascunho. Não pode citar fonte revogada.",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "pendencias": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "statusValidacao": { "enum": ["rascunho", "em_validacao", "validado"] },
    "tipoFonte": {
      "enum": ["legislacao", "pagina_oficial", "manual", "formulario", "sistema", "canal_atendimento", "outro"]
    },
    "pontoDeAcesso": {
      "type": "object",
      "required": ["nome", "url"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string" },
        "url": { "type": ["string", "null"], "description": "null enquanto pendente; quando preenchida, deve usar https://" }
      }
    },
    "fonte": {
      "type": "object",
      "required": [
        "id", "titulo", "tipo", "orgaoResponsavel", "url", "descricao", "origemOficial",
        "statusValidacao", "publicado", "dataPublicacao", "dataConsulta", "vigencia"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "titulo": { "type": "string", "minLength": 1 },
        "tipo": { "$ref": "#/$defs/tipoFonte" },
        "orgaoResponsavel": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://", "description": "Somente https; sem duplicidade no arquivo." },
        "descricao": { "type": "string" },
        "origemOficial": {
          "type": "boolean",
          "description": "Indica apenas que a fonte pertence a órgão público ou fonte institucional oficial. Não significa conteúdo validado."
        },
        "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
        "publicado": {
          "type": "boolean",
          "description": "Só pode ser true quando statusValidacao for validado. Fonte revogada ou com vigência a_confirmar nunca pode ser publicada."
        },
        "dataPublicacao": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dataConsulta": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dispositivoRelevante": { "type": ["string", "null"] },
        "vigencia": { "$ref": "#/$defs/vigencia" }
      }
    },
    "situacaoVigencia": { "enum": ["vigente", "alterada", "revogada", "a_confirmar", "nao_se_aplica"] },
    "vigencia": {
      "type": "object",
      "required": ["situacao", "normasRelacionadas", "observacao"],
      "additionalProperties": false,
      "properties": {
        "situacao": {
          "$ref": "#/$defs/situacaoVigencia",
          "description": "Fonte do tipo legislacao não usa nao_se_aplica; as demais usam somente nao_se_aplica."
        },
        "normasRelacionadas": {
          "type": "array",
          "description": "Ids de fontes do mesmo fontes.json. Obrigatório ao menos um quando a situação for revogada.",
          "items": { "type": "string" }
        },
        "observacao": { "type": ["string", "null"] }
      }
    },
    "arquivoFontes": {
      "type": "object",
      "required": ["serviceId", "statusValidacao", "fontes", "pendencia"],
      "properties": {
        "serviceId": { "type": "string" },
        "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
        "fontes": { "type": "array", "items": { "$ref": "#/$defs/fonte" } },
        "pendencia": { "type": "string" }
      }
    },
    "arquivoDocumentos": {
      "type": "object",
      "required": ["serviceId", "statusValidacao", "documentos", "pendencia"],
      "properties": {
        "serviceId": { "type": "string" },
        "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
        "documentos": {
          "type": "array",
          "items": { "$ref": "#/$defs/documento" }
        },
        "pendencia": { "type": "string" }
      }
    },
    "grupoDocumento": {
      "enum": ["empreendedor_empreendimento", "responsavel_tecnico", "imovel", "documentos_especificos", "estudos_planos_projetos"]
    },
    "estadoRevisaoAtualidade": { "enum": ["pendente", "em_revisao", "concluida"] },
    "documento": {
      "type": "object",
      "required": [
        "id", "grupo", "nome", "descricao", "aplicabilidade", "condicional", "obrigatorio",
        "fonteId", "localizacaoFonte", "statusValidacao", "publicado", "revisaoAtualidade", "alertas"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "grupo": { "$ref": "#/$defs/grupoDocumento" },
        "nome": { "type": "string", "minLength": 1 },
        "descricao": { "type": "string", "minLength": 1 },
        "aplicabilidade": { "type": "string", "minLength": 1, "description": "Condição de aplicação registrada na fonte." },
        "condicional": {
          "type": "boolean",
          "description": "Reflete a condição descrita na fonte (TR de 2020), não uma confirmação atual. false = a fonte não apresentou condição expressa naquele item; isso não significa que o documento esteja atualmente confirmado como obrigatório. A obrigatoriedade atual é representada por obrigatorio."
        },
        "alertas": {
          "type": "array",
          "description": "Sempre presente. Lista vazia quando não há inconsistência específica; quando há problema identificado, um ou mais textos não vazios.",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "obrigatorio": {
          "type": ["boolean", "null"],
          "description": "null = obrigatoriedade atual ainda não confirmada pela área competente (não significa dispensa). true/false só após revisão de atualidade concluída e validação."
        },
        "fonteId": { "type": "string", "description": "Identificador de uma fonte de fontes.json, não revogada." },
        "localizacaoFonte": { "type": "string", "minLength": 1, "description": "Numeração do item na fonte." },
        "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
        "publicado": {
          "type": "boolean",
          "description": "Só pode ser true com status validado, revisão de atualidade concluída e fonte publicada."
        },
        "revisaoAtualidade": { "$ref": "#/$defs/estadoRevisaoAtualidade" },
        "observacao": { "type": "string" }
      }
    },
    "arquivoPerguntas": {
      "type": "object",
      "required": ["serviceId", "statusValidacao", "perguntas", "pendencia"],
      "properties": {
        "serviceId": { "type": "string" },
        "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
        "perguntas": {
          "type": "array",
          "items": { "$ref": "#/$defs/pergunta" }
        },
        "pendencia": { "type": "string" }
      }
    },
    "temaPergunta": {
      "enum": [
        "conceito", "enquadramento", "legislacao", "siga", "documentos", "responsavel_tecnico",
        "imovel", "taxa", "prazo", "validade", "atendimento", "correcao", "outro"
      ]
    },
    "bloqueioPergunta": {
      "enum": [
        "desatualizacao", "vigencia", "informacao_variavel", "fonte_complementar", "conflito_com_base",
        "contato_desatualizado", "procedimento_do_sistema", "enquadramento_dependente_de_analise"
      ]
    },
    "pergunta": {
      "type": "object",
      "required": [
        "id", "numeroFonte", "pergunta", "tema", "conteudoFonte", "respostaPublicavel", "fonteId",
        "localizacaoFonte", "statusValidacao", "publicado", "revisaoAtualidade", "bloqueios", "alertas"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "numeroFonte": { "type": "string", "minLength": 1, "description": "Numeração da pergunta na fonte." },
        "pergunta": { "type": "string", "minLength": 1 },
        "tema": { "$ref": "#/$defs/temaPergunta" },
        "temasSecundarios": { "type": "array", "items": { "$ref": "#/$defs/temaPergunta" }, "uniqueItems": true },
        "conteudoFonte": {
          "type": "string",
          "minLength": 1,
          "description": "Resumo fiel do que a fonte (histórica) responde, em linguagem de fonte histórica. NUNCA é usado diretamente pelo assistente."
        },
        "respostaPublicavel": {
          "type": ["string", "null"],
          "description": "Resposta aprovada para o assistente. null enquanto não houver aprovação e publicação. Só ela poderá ser usada pelo assistente."
        },
        "fonteId": { "type": "string", "description": "Identificador de uma fonte de fontes.json, não revogada." },
        "localizacaoFonte": { "type": "string", "minLength": 1 },
        "statusValidacao": { "$ref": "#/$defs/statusValidacao" },
        "publicado": {
          "type": "boolean",
          "description": "Só pode ser true com status validado, revisão de atualidade concluída, resposta publicável preenchida, sem bloqueios e fonte publicada."
        },
        "revisaoAtualidade": { "$ref": "#/$defs/estadoRevisaoAtualidade" },
        "bloqueios": {
          "type": "array",
          "items": { "$ref": "#/$defs/bloqueioPergunta" },
          "uniqueItems": true,
          "description": "Motivos que impedem a publicação. Lista vazia só quando não há bloqueio específico (a pergunta continua em validação)."
        },
        "alertas": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      }
    }
  }
}
